<?xml version="1.0" encoding="utf-8"?>
<!--
  明文 HTTP 放行策略。

  1. 本地回调：Trae 登录完成会重定向到 http://127.0.0.1:51120/authorize
  2. 远程后台：管理后台当前只有 HTTP 入口（71api.636.ltd 及其备用域名），
     不放行会直接抛 "Cleartext HTTP traffic ... not permitted"。
     这些域名都是后台「域名健康」里下发的固定集合，改动需同步本文件。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">71api.636.ltd</domain>
        <domain includeSubdomains="true">wg.xbcsw.cn</domain>
        <domain includeSubdomains="true">wg.xhml.skin</domain>
        <domain includeSubdomains="true">wg.888456.xyz</domain>
    </domain-config>
</network-security-config>
