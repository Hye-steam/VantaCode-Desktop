#!/bin/sh
# VantaCode git credential helper.
#
# git 通过 credential.helper 调用本脚本（动作作为 $1，键值对从 stdin 读）。
# 凭据真源是 App 维护的 git-credentials（base64 后整体反转存盘），
# 命中就直出 username/password；未命中则写 cred-req-* 请求文件，
# 由 App 弹窗让用户回填，本脚本轮询 cred-resp-* 取走结果喂回 git。
#
# 远程服务器场景由 App 在第二行注入 AICODE_CRED_NO_PROMPT=1，
# 此时未命中直接失败退出，不等待弹窗。

AICODE_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
CRED_FILE="$AICODE_DIR/git-credentials"

# 百分号解码 + 加号转空格（App 侧用 URLEncoder.encode 写盘）
urldecode() {
    printf '%b' "$(printf '%s' "$1" | sed -e 's/+/ /g' -e 's/%\([0-9A-Fa-f][0-9A-Fa-f]\)/\\x\1/g')"
}

# base64 后整体反转 → 原文。没有 rev 时用 awk 逐字符反转。
decode_creds() {
    [ -f "$CRED_FILE" ] || return 1
    if command -v rev >/dev/null 2>&1; then
        rev "$CRED_FILE" | base64 -d 2>/dev/null
    else
        awk '{ n=length($0); s=""; for(i=n;i>=1;i--) s = s substr($0,i,1); print s }' "$CRED_FILE" \
            | base64 -d 2>/dev/null
    fi
}

action="${1:-get}"

# 读 stdin 的键值对。只关心 host / protocol / url / username。
host=""
protocol=""
url=""
in_username=""
while IFS= read -r line; do
    case "$line" in
        host=*)     host="${line#host=}" ;;
        protocol=*) protocol="${line#protocol=}" ;;
        url=*)      url="${line#url=}" ;;
        username=*) in_username="${line#username=}" ;;
    esac
done

# 有的调用只给 url=，从里面兜底取 host。
if [ -z "$host" ] && [ -n "$url" ]; then
    host=$(printf '%s' "$url" | sed -n 's|^[a-zA-Z][a-zA-Z0-9+.-]*://\([^/@]*@\)\{0,1\}\([^/:]*\).*|\2|p')
fi
host=$(printf '%s' "$host" | tr 'A-Z' 'a-z')

# store / erase 不改凭据文件：真源由 App 统一维护（编码格式只有 App 认识），
# 这里静默成功即可，避免把它改坏。
case "$action" in
    store|erase) exit 0 ;;
esac

[ -n "$host" ] || exit 0

# ── 1) 先在已保存的凭据里找 ──
found=$(decode_creds | awk -v want="$host" '
{
    line = $0
    at = 0
    n = length(line)
    for (i = n; i >= 1; i--) { if (substr(line, i, 1) == "@") { at = i; break } }
    if (at == 0) next
    h = tolower(substr(line, at + 1))
    if (h != want) next
    cred = substr(line, 1, at - 1)
    p = index(cred, "://")
    if (p > 0) cred = substr(cred, p + 3)
    c = index(cred, ":")
    if (c == 0) next
    print substr(cred, 1, c - 1)
    print substr(cred, c + 1)
    exit
}')

if [ -n "$found" ]; then
    user=$(printf '%s\n' "$found" | sed -n '1p')
    pass=$(printf '%s\n' "$found" | sed -n '2p')
    printf 'username=%s\n' "$(urldecode "$user")"
    printf 'password=%s\n' "$(urldecode "$pass")"
    exit 0
fi

# ── 2) 未保存：请求 App 弹窗回填 ──
# 服务器上没有 App，等待只会挂住命令，直接失败让 git 报认证错误。
[ "${AICODE_CRED_NO_PROMPT:-}" = "1" ] && exit 1
# 非交互场景（AI 跑的 Bash）也不等，否则命令一直卡到 watchdog 超时。
[ -t 0 ] || [ -t 1 ] || [ -n "${AICODE_CRED_FORCE_PROMPT:-}" ] || exit 1

req_id="$$-$(date +%s)"
req_file="$AICODE_DIR/cred-req-$req_id"
resp_file="$AICODE_DIR/cred-resp-$req_id"

cleanup() {
    rm -f "$req_file" "$req_file.tmp" "$resp_file" 2>/dev/null
}
trap cleanup EXIT INT TERM

# 写 .tmp 再 rename：App 侧会跳过 .tmp 后缀与空文件，避免读到半截内容。
printf 'host=%s\nprotocol=%s\nusername=%s\n' "$host" "$protocol" "$in_username" > "$req_file.tmp" 2>/dev/null || exit 1
mv -f "$req_file.tmp" "$req_file" 2>/dev/null || exit 1

# 轮询等回填。App 在有在途请求时会暂停超时杀进程，所以给足 5 分钟。
if sleep 0.2 2>/dev/null; then steps=1500; else steps=300; fi
i=0
while [ "$i" -lt "$steps" ]; do
    [ -f "$resp_file" ] && break
    if sleep 0.2 2>/dev/null; then :; else sleep 1; fi
    i=$((i + 1))
done

if [ ! -f "$resp_file" ]; then
    exit 1
fi

resp_user=$(sed -n 's/^username=//p' "$resp_file" | head -n 1)
resp_pass=$(sed -n 's/^password=//p' "$resp_file" | head -n 1)
resp_cancel=$(sed -n 's/^cancel=//p' "$resp_file" | head -n 1)

if [ -n "$resp_cancel" ] || [ -z "$resp_user" ]; then
    exit 1
fi

printf 'username=%s\n' "$resp_user"
printf 'password=%s\n' "$resp_pass"
exit 0
